VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Cloudinary (para adjuntar imagenes y documentos, plan gratuito sin tarjeta)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Conexion con el ERP contable (solo servidor, nunca en el navegador).
# El secreto debe ser el MISMO que AGENDA_SHARED_SECRET en el ERP.
ERP_SHARED_SECRET=
ERP_BASE_URL=https://mentes-brillantes-erp.vercel.app

# ---------------------------------------------------------------------------
# Solo servidor (Vercel -> Settings -> Environment Variables). Nunca VITE_.
# ---------------------------------------------------------------------------

# Quien es "del equipo" (puente con el ERP, asistente): miembros de una agenda
# cuyo dueno sea una de estas cuentas (uids de Firebase, separados por coma).
# Por defecto ya cuenta la de Sebastian (duena de la agenda "GEMB").
AGENDA_EQUIPO_DUENOS=

# Asistente de la agenda (DeepSeek).
DEEPSEEK_API_KEY=
# Opcional: fuerza un modelo concreto.
DEEPSEEK_MODEL=

# Conector MCP con OAuth (Claude / ChatGPT). Secreto propio y largo; si se
# cambia, hay que quitar y volver a agregar el conector en cada app.
OAUTH_SECRET=
# Opcional: hosts extra a los que puede volver el codigo OAuth (coma).
MCP_ALLOWED_REDIRECT_HOSTS=
# Opcional: direccion publica (si no, se toma la de la peticion).
PUBLIC_BASE_URL=

# Avisos push (los pide el despertador de Azure cada 5 minutos).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:correo-de-contacto@ejemplo.com
# Secreto compartido con Azure (cabecera x-push-secret).
PUSH_TICK_SECRET=
# Sesion de Firebase con la que el servidor lee la agenda para avisar.
PUSH_REFRESH_TOKEN=
# Agenda que se revisa para los avisos (por defecto, la del equipo).
PUSH_WORKSPACE_ID=
